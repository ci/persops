#!/usr/bin/env bash
set -euo pipefail

usage() {
	echo "usage: remote-verify <user> <host> <port>" >&2
}

if [ "$#" -ne 3 ]; then
	usage
	exit 2
fi

remote_user="$1"
remote_host="$2"
remote_port="$3"
ssh_opts=(-p "$remote_port" -o BatchMode=yes -o ConnectTimeout=10)

ssh "${ssh_opts[@]}" "${remote_user}@${remote_host}" bash -s -- "$remote_user" <<'REMOTE'
set -euo pipefail

remote_user="$1"

show_system_state() {
	echo "verify: system state"
	systemctl is-system-running --wait || true

	failed_units="$(systemctl --failed --no-legend --plain || true)"
	if [ -n "$failed_units" ]; then
		echo "warning: failed system units:"
		printf '%s\n' "$failed_units"
	fi
}

check_system_unit() {
	local unit="$1"

	if ! systemctl list-unit-files "$unit" --no-legend | grep -q .; then
		echo "verify: ${unit} not installed; skipping"
		return
	fi

	echo "verify: ${unit}"
	systemctl is-active --quiet "$unit"
	systemctl show "$unit" --property=ActiveState,SubState,Result,NRestarts,ExecMainStatus --no-pager
}

check_optional_system_unit() {
	local unit="$1"

	if ! systemctl list-unit-files "$unit" --no-legend | grep -q .; then
		echo "verify: ${unit} not installed; skipping"
		return
	fi

	echo "verify: ${unit}"
	systemctl show "$unit" --property=LoadState,UnitFileState,ActiveState,SubState,Result --no-pager
}

check_user_unit() {
	local unit="$1"
	local uid
	local runtime_dir

	uid="$(id -u "$remote_user")"
	runtime_dir="/run/user/${uid}"

	echo "verify: user ${unit}"
	sudo -u "$remote_user" XDG_RUNTIME_DIR="$runtime_dir" systemctl --user is-active --quiet "$unit"
	sudo -u "$remote_user" XDG_RUNTIME_DIR="$runtime_dir" systemctl --user show \
		"$unit" \
		--property=ActiveState,SubState,Result,NRestarts,ExecMainStatus \
		--no-pager
}

show_mount() {
	local mountpoint="$1"

	if findmnt -rn "$mountpoint" >/dev/null; then
		echo "verify: ${mountpoint} mounted"
	else
		echo "warning: ${mountpoint} not mounted"
	fi
}

check_tailscale_service_config() {
	local name="$1"
	local target="$2"

	echo "verify: Tailscale service config svc:${name}"
	if ! tailscale serve get-config --all |
		jq --exit-status --arg service "svc:${name}" --arg target "$target" \
			'.services[$service].endpoints["tcp:443"] == $target' >/dev/null; then
		echo "error: svc:${name} is not configured for ${target}" >&2
		return 1
	fi
}

printf 'verify: remote host '
hostname
show_system_state
check_system_unit tailscaled.service
check_system_unit actual.service
check_system_unit golink.service
check_system_unit home-assistant.service
check_system_unit tailscale-services.service

if command -v tailscale >/dev/null 2>&1; then
	printf 'verify: tailscale ip '
	tailscale ip -4 || true
fi
if ! command -v jq >/dev/null 2>&1; then
	echo "error: jq is required for Tailscale service verification" >&2
	exit 1
fi
check_tailscale_service_config actual http://127.0.0.1:5006
check_tailscale_service_config home-assistant http://127.0.0.1:8123

check_user_unit codex-remote-control.service
check_user_unit claude-remote-control.service
check_system_unit cliproxyapi.service
check_optional_system_unit samba-smbd.service
check_optional_system_unit sea16-quota-init.service
check_optional_system_unit restic-backups-actual-daily.timer
check_optional_system_unit restic-backups-golink-daily.timer
check_optional_system_unit restic-backups-archive-daily.timer
check_optional_system_unit restic-backups-archive-prune-monthly.timer
check_optional_system_unit restic-backups-archive-check-weekly.timer
show_mount /srv/sea16
show_mount /archive
REMOTE

check_client_endpoint() {
	local name="$1"
	local url="$2"
	local attempt

	echo "verify: client access to ${name} at ${url}"
	for attempt in {1..12}; do
		if curl --location --fail --silent --show-error --output /dev/null --connect-timeout 5 --max-time 10 "$url"; then
			return
		fi
		if [ "$attempt" -lt 12 ]; then
			sleep 5
		fi
	done

	echo "error: ${name} did not become reachable from the client" >&2
	return 1
}

if ! command -v curl >/dev/null 2>&1; then
	echo "error: curl is required for named service verification" >&2
	exit 1
fi
check_client_endpoint actual https://actual.reverse-justitia.ts.net/
check_client_endpoint golink https://golink.reverse-justitia.ts.net/
check_client_endpoint home-assistant https://home-assistant.reverse-justitia.ts.net/
