#!/usr/bin/env bash
set -euo pipefail

# Publish Kuma push tokens from private OpenTofu state to 1Password. Amalthea's
# opnix fetches op://persops/kuma-job-tokens/tokens.json on deploy or poll.
# Run inside the dedicated 1Password tmux session.
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/persops/uptime-kuma/terraform.tfstate"
export TF_DATA_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/persops/uptime-kuma/tofu"
umask 077
tokens="$(mktemp)"
trap 'rm -f "$tokens"' EXIT
tofu -chdir="$repo_root/infra/uptime-kuma" output -state="$state_file" -json job_push_tokens >"$tokens"
jq -e --slurpfile jobs "$repo_root/infra/uptime-kuma/jobs.json" \
	'(keys == ($jobs[0] | keys)) and all(.[]; type == "string" and test("^[A-Za-z0-9]+$"))' "$tokens" >/dev/null
op document edit kuma-job-tokens "$tokens" --file-name tokens.json --vault persops \
	--account my.1password.com >/dev/null
echo "Published Kuma job tokens; start opnix-secrets-poll.service on amalthea or deploy it."
