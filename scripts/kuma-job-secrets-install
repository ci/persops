#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/persops/uptime-kuma/terraform.tfstate"
export TF_DATA_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/persops/uptime-kuma/tofu"
umask 077
local_secret="$(mktemp)"
remote_dir=""
cleanup() {
	rm -f "$local_secret"
	if [[ "$remote_dir" == /tmp/kuma-job-health.* ]]; then
		ssh amalthea rm -f "$remote_dir/tokens.json" >/dev/null 2>&1 || true
		# Expand the validated remote mktemp path on this client intentionally.
		# shellcheck disable=SC2029
		ssh amalthea rmdir "$remote_dir" >/dev/null 2>&1 || true
	fi
}
trap cleanup EXIT
tofu -chdir="$repo_root/infra/uptime-kuma" output -state="$state_file" -json job_push_tokens >"$local_secret"
jq -e --slurpfile jobs "$repo_root/infra/uptime-kuma/jobs.json" \
	'(keys == ($jobs[0] | keys)) and all(.[]; type == "string" and test("^[A-Za-z0-9]+$"))' "$local_secret" >/dev/null
remote_dir="$(ssh amalthea mktemp -d /tmp/kuma-job-health.XXXXXX)"
[[ "$remote_dir" == /tmp/kuma-job-health.* ]]
scp -q "$local_secret" "amalthea:$remote_dir/tokens.json"
ssh amalthea sudo install -d -m 0700 -o root -g root /etc/secrets/kuma-job-health
ssh amalthea sudo install -m 0400 -o root -g root "$remote_dir/tokens.json" /etc/secrets/kuma-job-health/tokens.json
echo "Installed private Kuma job tokens; deploy/restart kuma-job-health.service after changes."
