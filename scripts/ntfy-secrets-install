#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
local_secret="$(mktemp)"
remote_secret="/tmp/ntfy-sh.environment"

cleanup() {
  rm -f "$local_secret"
  ssh amalthea rm -f "$remote_secret" >/dev/null 2>&1 || true
}
trap cleanup EXIT

umask 077
op inject --account my.1password.com -i "$repo_root/infra/ntfy/environment.tpl" >"$local_secret"
scp -q "$local_secret" "amalthea:$remote_secret"
ssh amalthea sudo install -d -m 0700 -o root -g root /etc/secrets/ntfy-sh
ssh amalthea sudo install -m 0400 -o root -g root "$remote_secret" /etc/secrets/ntfy-sh/environment

echo "installed /etc/secrets/ntfy-sh/environment on amalthea"
